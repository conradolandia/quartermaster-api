# CI / GitHub Actions: safe placeholder values for backend tests in Docker Compose.
# Copied to .env in CI (see .github/workflows/ci.yml). Not for production.
#
# Do not replace your local .env with this file for day-to-day dev. For local tests
# with a separate DB, set POSTGRES_DB_TEST only (keep POSTGRES_DB as your dev database).

DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local

PROJECT_NAME=Quartermaster API
EMAIL_BRAND_NAME=Star Fleet Tours
STACK_NAME=quartermaster-api

BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173
SECRET_KEY=ci-secret-key-not-for-production
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=ci-admin-password
RUN_INITIAL_DATA=1

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=2525

POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=quartermaster_api_test
POSTGRES_DB_TEST=quartermaster_api_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ci-postgres-password

SENTRY_DSN=

DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=

CI=1
